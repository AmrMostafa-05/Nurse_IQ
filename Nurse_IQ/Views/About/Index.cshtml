@model dynamic
@{
    ViewData["Title"] = "من نحن - NursingIQ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Hero Section -->
<section class="about-hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="display-4 fw-bold mb-4" style="color: aliceblue;">من نحن</h1>
                <p class="lead mb-4" style="color: aliceblue;">منصة NursingIQ هي منصة تعليمية متخصصة في مجال التمريض، تهدف إلى تقديم محتوى تعليمي عالي الجودة لطلاب التمريض في جميع أنحاء الوطن العربي.</p>
                <div class="d-flex flex-wrap gap-3">
                    <div class="stat-item">
                        <span class="stat-number" data-target="10">0</span>
                        <div class="stat-label">طالب نشط</div>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number" data-target="2">0</span>
                        <div class="stat-label">مادة دراسية</div>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number" data-target="4">0</span>
                        <div class="stat-label">مدرس محترف</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Mission Section -->
<section class="mission-section">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-8 mx-auto">
                <h2 class="display-5 fw-bold mb-4">مهمتنا ورؤيتنا</h2>
                <p class="lead text-muted">نسعى لتقديم أفضل تجربة تعليمية لطلاب التمريض من خلال محتوى تفاعلي ومتطور</p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="mission-card">
                    <div class="mission-icon">
                        <i class="bi bi-lightbulb"></i>
                    </div>
                    <h3 class="h4 mb-3">الرؤية</h3>
                    <p class="text-muted">أن نكون المنصة التعليمية الأولى في مجال التمريض في الوطن العربي، ونقدم محتوى تعليمي عالي الجودة يساعد الطلاب على تحقيق أحلامهم.</p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="mission-card">
                    <div class="mission-icon">
                        <i class="bi bi-target"></i>
                    </div>
                    <h3 class="h4 mb-3">المهمة</h3>
                    <p class="text-muted">تقديم محتوى تعليمي متطور ومتخصص في مجال التمريض، مع التركيز على الجوانب العملية والنظرية، ومساعدة الطلاب على تطوير مهاراتهم.</p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="mission-card">
                    <div class="mission-icon">
                        <i class="bi bi-heart"></i>
                    </div>
                    <h3 class="h4 mb-3">القيم</h3>
                    <p class="text-muted">نؤمن بالجودة العالية، والابتكار، والشفافية، والتعاون، ونضع مصلحة الطلاب في المقام الأول.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Team Section -->
<section class="team-section">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-8 mx-auto">
                <h2 class="display-5 fw-bold mb-4">فريق العمل</h2>
                <p class="lead text-muted">
                    تعرف على الفريق المتميز الذي يعمل خلف الكواليس لتقديم أفضل تجربة تعليمية
                </p>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-3 col-md-6">
                <div class="team-member">
                    <h4 class="h5 mb-2">محمد علاء</h4>
                    <p class="text-muted">مدير المحتوى التعليمي</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="team-member">
                    <h4 class="h5 mb-2">أحمد ضاحي</h4>
                    <p class="text-muted">مدير التطوير التقني</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="team-member">
                    <h4 class="h5 mb-2">الحسن احمد</h4>
                    <p class="text-muted">مدير التطوير التقني</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="team-member">
                    <h4 class="h5 mb-2">عمرو مصطفي</h4>
                    <p class="text-muted">مدير التطوير التقني</p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Stats Section -->
<section class="stats-section">
    <div class="container">
        <div class="row text-center">
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="stat-item">
                    <span class="stat-number" data-target="10">0</span>
                    <div class="stat-label">طالب مسجل</div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="stat-item">
                    <span class="stat-number" data-target="5">0</span>
                    <div class="stat-label">فيديو تعليمي</div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="stat-item">
                    <span class="stat-number" data-target="20">0</span>
                    <div class="stat-label">اختبار</div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="stat-item">
                    <span class="stat-number" data-target="95">0</span>
                    <div class="stat-label">% رضا الطلاب</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Values Section -->
<section class="values-section">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-8 mx-auto">
                <h2 class="display-5 fw-bold mb-4">قيمنا الأساسية</h2>
                <p class="lead text-muted">القيم التي نؤمن بها ونسعى لتحقيقها في كل ما نقدمه</p>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-6">
                <div class="value-item">
                    <div class="value-icon">
                        <i class="bi bi-award"></i>
                    </div>
                    <div>
                        <h4 class="h5 mb-2">الجودة العالية</h4>
                        <p class="text-muted mb-0">نحرص على تقديم محتوى تعليمي عالي الجودة يلبي احتياجات الطلاب</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="value-item">
                    <div class="value-icon">
                        <i class="bi bi-lightbulb"></i>
                    </div>
                    <div>
                        <h4 class="h5 mb-2">الابتكار</h4>
                        <p class="text-muted mb-0">نستخدم أحدث التقنيات والطرق التعليمية لتقديم تجربة فريدة</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="value-item">
                    <div class="value-icon">
                        <i class="bi bi-people"></i>
                    </div>
                    <div>
                        <h4 class="h5 mb-2">التعاون</h4>
                        <p class="text-muted mb-0">نؤمن بأهمية العمل الجماعي والتعاون لتحقيق الأهداف المشتركة</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="value-item">
                    <div class="value-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div>
                        <h4 class="h5 mb-2">الموثوقية</h4>
                        <p class="text-muted mb-0">نقدم معلومات موثوقة ودقيقة من مصادر معتمدة</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
