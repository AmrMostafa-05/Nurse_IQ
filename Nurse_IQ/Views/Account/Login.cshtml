@model LoginUserViewModel
@{
    ViewData["Title"] = "تسجيل الدخول";
}
<!-- Breadcrumb Container -->
<div id="breadcrumb-container" class="container mt-4"></div>

<!-- Login Section -->
<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card border-0 shadow">
                    <div class="card-body p-5">
                        <div class="text-center mb-4">
                            <i class="bi bi-heart-pulse-fill text-primary display-4 mb-3"></i>
                            <h2 class="fw-bold text-primary">تسجيل الدخول</h2>
                            <p class="text-muted">مرحباً بك في NursingIQ</p>
                        </div>

                        <form asp-action="Login" id="loginForm">
                            <div asp-validation-summary="All" class="text-danger mb-3"></div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label">البريد الإلكتروني</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-envelope"></i>
                                    </span>
                                    <input asp-for="Email" class="form-control" id="loginEmail" placeholder="أدخل بريدك الإلكتروني" required>
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label">كلمة المرور</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-lock"></i>
                                    </span>
                                    <input asp-for="Password" class="form-control" id="loginPassword" placeholder="أدخل كلمة المرور" required>
                                    <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('loginPassword')">
                                        <i class="bi bi-eye" id="loginPasswordIcon"></i>
                                    </button>
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" asp-for="RememberMe" id="rememberMe">
                                    <label class="form-check-label" for="rememberMe">
                                        @Html.DisplayNameFor(model => model.RememberMe)
                                    </label>
                                </div>
                                <a href="#" class="text-decoration-none" data-bs-toggle="modal" data-bs-target="#forgotPasswordModal">نسيت كلمة المرور؟</a>
                            </div>

                            <div class="d-grid mb-3">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="bi bi-box-arrow-in-right me-2"></i>تسجيل الدخول
                                </button>
                            </div>

                            <div class="text-center mb-3">
                                <span class="text-muted">أو</span>
                            </div>

                            <div class="d-grid gap-2 mb-4">
                                <button type="button" class="btn btn-outline-dark" onclick="loginWithGoogle()">
                                    <i class="bi bi-google me-2"></i>تسجيل الدخول بحساب Google
                                </button>
                                <button type="button" class="btn btn-outline-primary" onclick="loginWithFacebook()">
                                    <i class="bi bi-facebook me-2"></i>تسجيل الدخول بحساب Facebook
                                </button>
                            </div>

                            <div class="text-center">
                                <p class="text-muted mb-0">
                                    ليس لديك حساب؟
                                    <a asp-action="Register" class="text-decoration-none fw-bold">إنشاء حساب جديد</a>
                                </p>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

