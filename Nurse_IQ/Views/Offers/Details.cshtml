@model Nurse_IQ.Models.Offer
@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="h2 fw-bold text-primary mb-4">@Model.Title</h2>
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-4">
                    <img src="@Model.imageUrl" class="img-fluid rounded" alt="@Model.Title">
                </div>
                <div class="col-md-8">
                    <h6 class="text-muted">@Model.SubTitle</h6>
                    <p class="mb-3">@Model.Description</p>
                    <div class="row mb-3">
                        <div class="col-6">
                            <div class="text-center p-3 bg-light rounded">
                                <div class="text-decoration-line-through text-muted">@Model.OriginalPrice.ToString("C")</div>
                                <div class="h4 text-success mb-0">@Model.LastPrice.ToString("C")</div>
                                <small class="text-success">توفير: @Model.DiscountPrice.ToString("C")</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="text-center p-3 bg-light rounded">
                                <div class="h4 text-primary mb-0">خصم @Model.DiscountPercentage%</div>
                                <small class="text-muted">من السعر الأصلي</small>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <strong>المميزات:</strong>
                        <ul class="mt-2">
                            @foreach (var feature in Model.features)
                            {
                                <li>@feature</li>
                            }
                        </ul>
                    </div>
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>
                        ينتهي العرض في: <span id="countdown-@Model.Id">@Model.expiredAt.ToString("yyyy-MM-dd")</span>
                    </div>
                    <div class="d-flex gap-2 mb-4">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <button class="btn btn-primary" onclick="claimOffer(@Model.Id)">
                                <i class="bi bi-cart-plus me-2"></i>احصل على العرض
                            </button>
                            if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning">تعديل</a>
                                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">حذف</a>
                            }
                        }
                        else
                        {
                            <a href="/Identity/Account/Login" class="btn btn-primary">
                                <i class="bi bi-cart-plus me-2"></i>تسجيل الدخول للحصول على العرض
                            </a>
                        }
                    </div>
                    <div class="mt-4">
                        <a asp-action="Index" class="btn btn-primary">العودة إلى القائمة</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateCountdown(offerId, endDate) {
            const now = new Date();
            const diff = new Date(endDate) - now;
            if (diff > 0) {
                const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                document.getElementById(`countdown-${offerId}`).textContent = `${days} يوم ${hours} ساعة ${minutes} دقيقة`;
            } else {
                document.getElementById(`countdown-${offerId}`).textContent = 'انتهى العرض';
            }
        }

        async function claimOffer(offerId) {
            showToast('جاري تطبيق العرض...', 'info');
            setTimeout(() => {
                showToast('تم تطبيق العرض بنجاح!', 'success');
            }, 2000);
        }

        function showToast(message, type) {
            const toastContainer = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast align-items-center text-white bg-${type} border-0`;
            toast.innerHTML = `
                <div class="d-flex">
                    <div class="toast-body">${message}</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>`;
            toastContainer.appendChild(toast);
            new bootstrap.Toast(toast).show();
        }

        document.addEventListener('DOMContentLoaded', function () {
            updateCountdown(@Model.Id, '@Model.expiredAt.ToString("o")');
            setInterval(() => {
                updateCountdown(@Model.Id, '@Model.expiredAt.ToString("o")');
            }, 60000);
        });
    </script>
}