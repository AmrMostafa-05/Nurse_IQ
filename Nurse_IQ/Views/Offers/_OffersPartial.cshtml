@model IEnumerable<Nurse_IQ.Models.Offer>

@foreach (var offer in Model)
{
    <div class="col-md-6 col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <img src="@(offer.imageUrl ?? "/img/default-offer.jpg")" class="card-img-top" alt="@offer.Title" style="height: 200px; object-fit: cover;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h5 class="card-title mb-0">@offer.Title</h5>
                    <span class="badge bg-primary">@offer.category</span>
                </div>
                <p class="card-text text-muted small mb-2">@offer.SubTitle</p>
                <p class="card-text small">@offer.Description</p>
                <div class="row text-center mb-3">
                    <div class="col-6">
                        <small class="text-muted">السعر الأصلي</small>
                        <div class="text-decoration-line-through text-muted">@offer.OriginalPrice.ToString("C")</div>
                    </div>
                    <div class="col-6">
                        <small class="text-muted">السعر النهائي</small>
                        <div class="text-success fw-bold">@offer.LastPrice.ToString("C")</div>
                    </div>
                </div>
                <div class="mb-3">
                    <small class="text-muted">
                        <i class="bi bi-clock me-1"></i>ينتهي في: <span id="countdown-@offer.Id">@offer.expiredAt.ToString("yyyy-MM-dd")</span>
                    </small>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <a asp-action="Details" asp-route-id="@offer.Id" class="btn btn-primary btn-sm">
                        <i class="bi bi-info-circle me-2"></i>تفاصيل العرض
                    </a>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <button class="btn btn-outline-success btn-sm" onclick="claimOffer(@offer.Id)">
                            <i class="bi bi-cart-plus me-2"></i>احصل على العرض
                        </button>
                        if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@offer.Id" class="btn btn-outline-warning btn-sm">
                                <i class="bi bi-pencil me-2"></i>تعديل
                            </a>
                            <a asp-action="Delete" asp-route-id="@offer.Id" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-trash me-2"></i>حذف
                            </a>
                        }
                    }
                    else
                    {
                        <a href="/Identity/Account/Login" class="btn btn-outline-success btn-sm">
                            <i class="bi bi-cart-plus me-2"></i>تسجيل الدخول للحصول على العرض
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
}