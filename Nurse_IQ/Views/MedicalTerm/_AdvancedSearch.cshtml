@using Nurse_IQ.Enums.MedicalTerm

<div class="modal-header">
    <h5 class="modal-title fw-bold">بحث متقدم</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <form id="advancedSearchForm" asp-antiforgery="true">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="mb-3">
                    <label for="advSearchTerm" class="form-label fw-bold text-primary">المصطلح</label>
                    <input type="text" class="form-control" id="advSearchTerm" name="searchTerm" placeholder="اكتب المصطلح...">
                </div>
                <div class="mb-3">
                    <label for="advCategory" class="form-label fw-bold text-primary">التصنيف</label>
                    <select class="form-select" id="advCategory" name="category">
                        <option value="">جميع الفئات</option>
                        @foreach (var cat in Enum.GetValues(typeof(Category)))
                        {
                            <option value="@cat">@cat</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label for="advLetter" class="form-label fw-bold text-primary">الحرف الأول</label>
                    <select class="form-select" id="advLetter" name="letter">
                        <option value="">أي حرف</option>
                        @foreach (var letter in "أبتثجحخدذرزسشصضطظعغفقكلمنهوي".ToCharArray())
                        {
                            <option value="@letter">@letter</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
            <button type="submit" class="btn btn-primary">بحث</button>
        </div>
    </form>
</div>
