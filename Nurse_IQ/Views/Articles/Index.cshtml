@model IEnumerable<Article>

@{
    ViewData["Title"] = "المقالات الطبية";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Banner -->
<section class="page-banner">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="display-4 fw-bold mb-3">المقالات الطبية</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                        <li class="breadcrumb-item active">المقالات</li>
                    </ol>
                </nav>
            </div>
            <div class="col-lg-4 text-center">
                <img src="~/img/i6.jpg" alt="Medical Articles" class="img-fluid rounded" style="max-height: 200px;">
            </div>
        </div>
    </div>
</section>

<!-- Articles Section -->
<section class="py-5">
    <div class="container">
        <div class="row">
            <!-- Main Content -->
            <div class="col-lg-8">
                <!-- Create Button for Authors -->
                @if (User.IsInRole("Doctor") || User.IsInRole("Admin"))
                {
                    <div class="mb-4">
                        <a asp-action="Create" class="btn btn-primary">
                            <i class="bi bi-plus-circle"></i> مقال جديد
                        </a>
                    </div>
                }

                <!-- Featured Article -->
                @{
                    var featuredArticle = Model.FirstOrDefault();
                    if (featuredArticle != null)
                    {
                        <div class="card border-0 shadow-sm mb-5">
                            <div class="row g-0">
                                <div class="col-md-4">
                                    <img src="@featuredArticle.imageUrl" class="img-fluid h-100" alt="@featuredArticle.Title" style="object-fit: cover;">
                                </div>
                                <div class="col-md-8">
                                    <div class="card-body">
                                        <div class="d-flex align-items-center mb-2">
                                            <span class="badge bg-primary me-2">@featuredArticle.category</span>
                                            <small class="text-muted">@featuredArticle.publishDate</small>
                                        </div>
                                        <h3 class="card-title">@featuredArticle.Title</h3>
                                        <p class="card-text">@featuredArticle.Description</p>
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div class="d-flex align-items-center">
                                                <img src="@featuredArticle.authorImage" alt="@featuredArticle.User?.FullName" class="rounded-circle me-2" width="30" height="30">
                                                <small class="text-muted">@featuredArticle.User?.FullName</small>
                                            </div>
                                            <a asp-action="Details" asp-route-id="@featuredArticle.Id" class="btn btn-outline-primary btn-sm">اقرأ المزيد</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }

                <!-- Articles Grid -->
                <div class="row g-4" id="articlesGrid">
                    @foreach (var article in Model.Skip(1))
                    {
                        <div class="col-md-6">
                            <div class="card h-100 border-0 shadow-sm">
                                <img src="@article.imageUrl" class="card-img-top" alt="@article.Title" style="height: 200px; object-fit: cover;">
                                <div class="card-body">
                                    <div class="d-flex align-items-center mb-2">
                                        <span class="badge bg-primary me-2">@article.category</span>
                                        <small class="text-muted">@article.publishDate</small>
                                    </div>
                                    <h5 class="card-title">@article.Title</h5>
                                    <p class="card-text text-muted">@article.Description</p>
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center">
                                            <img src="@article.authorImage" alt="@article.User?.FullName" class="rounded-circle me-2" width="25" height="25">
                                            <small class="text-muted">@article.User?.FullName</small>
                                        </div>
                                        <small class="text-muted">
                                            <i class="bi bi-eye me-1"></i>@article.Num_of_views
                                        </small>
                                    </div>
                                </div>
                                <div class="card-footer bg-transparent border-0">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <small class="text-muted">
                                            <i class="bi bi-clock me-1"></i>@article.readTime
                                        </small>
                                        <a asp-action="Details" asp-route-id="@article.Id" class="btn btn-outline-primary btn-sm">
                                            اقرأ المزيد
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <!-- Search -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <h6 class="mb-3">البحث في المقالات</h6>
                        <div class="input-group">
                            <input type="text" class="form-control" placeholder="ابحث عن مقال..." id="searchInput">
                            <button class="btn btn-primary" type="button" onclick="searchArticles()">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Categories -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <h6 class="mb-3">التصنيفات</h6>
                        <div class="categories-list">
                            <a href="#" class="category-item d-flex align-items-center justify-content-between p-2 border rounded mb-2" onclick="filterByCategory('all')">
                                <span>جميع التصنيفات</span>
                                <span class="badge bg-secondary">@Model.Count()</span>
                            </a>
                            @foreach (var category in ViewBag.Categories)
                            {
                                var count = Model.Count(a => a.category == category);
                                <a href="#" class="category-item d-flex align-items-center justify-content-between p-2 border rounded mb-2" onclick="filterByCategory('@category')">
                                    <span>@category</span>
                                    <span class="badge bg-primary">@count</span>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function searchArticles() {
            const searchTerm = document.getElementById('searchInput').value;
            window.location.href = '@Url.Action("Index")' + '?search=' + encodeURIComponent(searchTerm);
        }

        function filterByCategory(category) {
            window.location.href = '@Url.Action("Index")' + '?category=' + encodeURIComponent(category);
        }

        // AJAX search functionality
        document.getElementById('searchInput').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                searchArticles();
            }
        });
    </script>
}