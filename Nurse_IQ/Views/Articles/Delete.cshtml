@model Nurse_IQ.Models.Article
@{
    ViewData["Title"] = "حذف المقال";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="h2 fw-bold text-primary mb-4">حذف المقال</h2>
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <h5 class="text-danger">هل أنت متأكد من حذف هذا المقال؟</h5>
            <div class="mb-3">
                <strong>عنوان المقال:</strong> @Model.Title
            </div>
            <div class="mb-3">
                <strong>التصنيف:</strong> @Model.category
            </div>
            <div class="mb-3">
                <strong>تاريخ النشر:</strong> @Model.publishDate
            </div>
            <div class="mb-3">
                <strong>المؤلف:</strong> @Model.User.UserName
            </div>
            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">حذف</button>
                    <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>