@model HomeViewModel
@{
    ViewData["Title"] = "الرئيسية";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center min-vh-100">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold text-primary mb-4">
                    منصة مساعدة طلاب التمريض
                </h1>
                <p class="lead text-muted mb-5">
                    اكتشف المواد الدراسية، انضم للتدريب العملي، وطور مهاراتك في مجال التمريض
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Course" asp-action="Index" class="btn btn-primary btn-lg">
                        <i class="bi bi-book me-2"></i>استكشف المواد
                    </a>
                    <a asp-controller="Training" asp-action="Index" class="btn btn-outline-primary btn-lg">
                        <i class="bi bi-calendar-check me-2"></i>انضم للتدريب
                    </a>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <div class="hero-illustration">
                    <div class="floating-card card-1">
                        <i class="bi bi-heart-pulse text-primary"></i>
                        <span>رعاية صحية</span>
                    </div>
                    <div class="floating-card card-2">
                        <i class="bi bi-book text-success"></i>
                        <span>تعليم</span>
                    </div>
                    <div class="floating-card card-3">
                        <i class="bi bi-people text-warning"></i>
                        <span>مجتمع</span>
                    </div>
                    <div class="main-illustration">
                        <i class="bi bi-heart-pulse-fill text-primary display-1"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-8 mx-auto">
                <h2 class="display-6 fw-bold text-primary mb-3">لماذا تختار NursingIQ؟</h2>
                <p class="lead text-muted">منصة شاملة تجمع بين التعليم النظري والتدريب العملي</p>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card text-center p-4">
                    <div class="feature-icon mb-4">
                        <i class="bi bi-book text-primary display-4"></i>
                    </div>
                    <h4 class="mb-3">مواد شاملة</h4>
                    <p class="text-muted">مواد دراسية شاملة تغطي جميع جوانب التمريض</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card text-center p-4">
                    <div class="feature-icon mb-4">
                        <i class="bi bi-calendar-check text-success display-4"></i>
                    </div>
                    <h4 class="mb-3">تدريب عملي</h4>
                    <p class="text-muted">تدريب عملي في مستشفيات ومعاهد معتمدة</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card text-center p-4">
                    <div class="feature-icon mb-4">
                        <i class="bi bi-people text-warning display-4"></i>
                    </div>
                    <h4 class="mb-3">دعم متخصص</h4>
                    <p class="text-muted">دعم من خبراء في مجال التمريض</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Statistics Section -->
<section class="py-5 bg-primary text-white">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-md-3">
                <div class="stat-item">
                    <i class="bi bi-book display-4 mb-3"></i>
                    <h3 class="fw-bold">@Model.CoursesCount+</h3>
                    <p class="mb-0">مادة دراسية</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-item">
                    <i class="bi bi-people display-4 mb-3"></i>
                    <h3 class="fw-bold">@Model.UsersCount+</h3>
                    <p class="mb-0">طالب</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-item">
                    <i class="bi bi-hospital display-4 mb-3"></i>
                    <h3 class="fw-bold">@Model.TrainingsCount+</h3>
                    <p class="mb-0">مستشفى شريك</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-item">
                    <i class="bi bi-award display-4 mb-3"></i>
                    <h3 class="fw-bold">95%</h3>
                    <p class="mb-0">معدل الرضا</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Latest Articles Section -->
@if (Model.LatestArticles.Any())
{
    <section class="py-5">
        <div class="container">
            <div class="row text-center mb-5">
                <div class="col-lg-8 mx-auto">
                    <h2 class="display-6 fw-bold text-primary mb-3">أحدث المقالات</h2>
                    <p class="lead text-muted">مقالات طبية حديثة ومفيدة</p>
                </div>
            </div>
            <div class="row g-4">
                @foreach (var article in Model.LatestArticles)
                {
                    <div class="col-md-4">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body p-4">
                                <h5 class="card-title">@article.Title</h5>
                                <p class="card-text text-muted">@article.Description</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted">@article.publishDate.ToString()</small>
                                    <a href="#" class="btn btn-outline-primary btn-sm">اقرأ المزيد</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- Latest Trainings Section -->
@if (Model.LatestTrainings.Any())
{
    <section class="py-5 bg-light">
        <div class="container">
            <div class="row text-center mb-5">
                <div class="col-lg-8 mx-auto">
                    <h2 class="display-6 fw-bold text-primary mb-3">أحدث التدريبات</h2>
                    <p class="lead text-muted">فرص تدريبية جديدة في مستشفيات مختلفة</p>
                </div>
            </div>
            <div class="row g-4">
                @foreach (var training in Model.LatestTrainings)
                {
                    <div class="col-md-4">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body p-4">
                                <h5 class="card-title">@training.Title</h5>
                                <p class="card-text text-muted">@training.Description</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted">@training.HospitalName</small>
                                    <a href="#" class="btn btn-outline-success btn-sm">انضم الآن</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- Testimonials Section -->
<section class="py-5">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-8 mx-auto">
                <h2 class="display-6 fw-bold text-primary mb-3">آراء الطلاب</h2>
                <p class="lead text-muted">تعرف على تجارب الطلاب مع منصتنا</p>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="testimonial-card text-center p-4">
                    <div class="testimonial-avatar mb-3">
                        <img src="~/img/i1.jpg" alt="Student" class="rounded-circle" width="80" height="80">
                    </div>
                    <h5 class="mb-2">سارة أحمد</h5>
                    <p class="text-muted small mb-3">طالبة تمريض - المستوى الثالث</p>
                    <p class="mb-3">"المنصة ساعدتني كثيراً في فهم المواد الدراسية. المحاضرات واضحة والمواد منظمة بشكل ممتاز"</p>
                    <div class="rating">
                        <i class="bi bi-star-fill text-warning"></i>
                        <i class="bi bi-star-fill text-warning"></i>
                        <i class="bi bi-star-fill text-warning"></i>
                        <i class="bi bi-star-fill text-warning"></i>
                        <i class="bi bi-star-fill text-warning"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="testimonial-card text-center p-4">
                    <div class="testimonial-avatar mb-3">
                        <img src="~/img/i2.jpg" alt="Student" class="rounded-circle" width="80" height="80">
                    </div>
                    <h5 class="mb-2">محمد علي</h5>
                    <p class="text-muted small mb-3">طالب تمريض - المستوى الثاني</p>
                    <p class="mb-3">"التدريب العملي كان ممتاز. تعلمت مهارات جديدة وساعدني في تطوير قدراتي العملية"</p>
                    <div class="rating">
                        <i class="bi bi-star-fill text-warning"></i>
                        <i class="bi bi-star-fill text-warning"></i>
                        <i class="bi bi-star-fill text-warning"></i>
                        <i class="bi bi-star-fill text-warning"></i>
                        <i class="bi bi-star"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="testimonial-card text-center p-4">
                    <div class="testimonial-avatar mb-3">
                        <img src="~/img/i3.jpg" alt="Student" class="rounded-circle" width="80" height="80">
                    </div>
                    <h5 class="mb-2">فاطمة محمود</h5>
                    <p class="text-muted small mb-3">طالبة تمريض - المستوى الرابع</p>
                    <p class="mb-3">"المهارات العملية ساعدتني كثيراً في تطوير قدراتي في مجال التمريض"</p>
                    <div class="rating">
                        <i class="bi bi-star-fill text-warning"></i>
                        <i class="bi bi-star-fill text-warning"></i>
                        <i class="bi bi-star-fill text-warning"></i>
                        <i class="bi bi-star-fill text-warning"></i>
                        <i class="bi bi-star-fill text-warning"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="py-5 bg-gradient-primary text-white">
    <div class="container text-center">
        <h2 class="display-6 fw-bold mb-4">هل أنت مستعد للبدء؟</h2>
        <p class="lead mb-4" style="color: aliceblue;">انضم إلينا اليوم وابدأ رحلة التعلم في مجال التمريض</p>
        <div class="d-flex gap-3 justify-content-center flex-wrap">
            <a asp-controller="Account" asp-action="Register" class="btn btn-light btn-lg">
                <i class="bi bi-person-plus me-2"></i>سجل الآن
            </a>
            <a asp-controller="Course" asp-action="Index" class="btn btn-outline-light btn-lg">
                <i class="bi bi-book me-2"></i>استكشف المواد
            </a>
        </div>
</div>
</section>
