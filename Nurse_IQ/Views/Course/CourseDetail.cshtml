@model Course

<!-- Course Header -->
<section class="course-header py-4">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                <li class="breadcrumb-item"><a asp-controller="Course" asp-action="Index">المواد الدراسية</a></li>
                <li class="breadcrumb-item active">@Model.Name</li>
            </ol>
        </nav>

        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-5 fw-bold mb-3">@Model.Title</h1>
                <p class="lead mb-4">@Model.smallDescription</p>

                <div class="course-stats row">
                    <div class="col-4 text-center">
                        <span class="stat-number">@Model.Lectures.Count</span>
                        <span class="stat-label">محاضرة</span>
                    </div>
                    <div class="col-4 text-center">
                        <span class="stat-number">@Model.Duration</span>
                        <span class="stat-label">المدة</span>
                    </div>
                    <div class="col-4 text-center">
                        <span class="stat-number">@Model.Quizzes.Count</span>
                        <span class="stat-label">اختبار</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <img src="@Model.imageUrl" alt="@Model.Name" class="img-fluid rounded" style="max-height:300px;">
            </div>
        </div>
    </div>
</section>

<!-- Main Content -->
<div class="container my-5">
    <div class="row">
        <!-- Left: Details -->
        <div class="col-lg-8">
            <!-- Description -->
            <div class="mb-5">
                <h4><i class="bi bi-info-circle me-2"></i>وصف الكورس</h4>
                <p>@Model.bigDescription</p>
            </div>

            <!-- What Student Learns -->
            @if (Model.courseTopics.Any())
            {
                <div class="mb-5">
                    <h5>ما سيتعلمه الطالب:</h5>
                    <ul>
                        @foreach (var topic in Model.courseTopics)
                        {
                            <li>@topic</li>
                        }
                    </ul>
                </div>
            }
            <!-- Lectures -->
            <div class="mb-5">
                <h4><i class="bi bi-play-circle me-2"></i>المحاضرات</h4>
                <ul class="list-group">
                    @foreach (var lecture in Model.Lectures)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                <strong>@lecture.Title</strong>
                                <small class="text-muted d-block">@lecture.smallDescription</small>
                            </span>
                            <a asp-controller="Lecture" asp-action="Lecture_Detail" asp-route-id="@lecture.Id"
                               class="btn btn-sm btn-outline-primary">
                                مشاهدة <i class="bi bi-play-circle"></i>
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <div class="card p-3">
                    <h5 class="mb-3">ابدأ رحلة التعلم</h5>
                    <p class="text-muted">اختر المحاضرة الأولى لتبدأ</p>
                    <a asp-controller="Lecture" asp-action="Lecture_Detail"
                       asp-route-id="@Model.Lectures.FirstOrDefault()?.Id"
                       class="btn btn-primary w-100 mb-2">
                        <i class="bi bi-play-circle me-2"></i>ابدأ المحاضرة الأولى
                    </a>
                    <a asp-controller="Course" asp-action="Index" class="btn btn-outline-primary w-100">
                        <i class="bi bi-arrow-left me-2"></i>العودة للمواد
                    </a>
                </div>
            </div>
            
