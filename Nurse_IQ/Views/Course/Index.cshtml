@model List<Course>
@{
    ViewData["Title"] = "المحتوي الدراسي";
}
<!-- Page Banner -->
<section class="page-banner bg-gradient-primary text-white py-5">
    <div class="container">
        <div class="row align-items-center">
            <!-- النصوص -->
            <div class="col-lg-8">
                <h1 class="display-4 fw-bold mb-3">المحتوي الدراسي</h1>

                <!-- Breadcrumb -->
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-controller="Home" asp-action="Index" class="text-light text-decoration-none">
                                الرئيسية
                            </a>
                        </li>
                        <li class="breadcrumb-item active text-white" aria-current="page">
                            المحتوي الدراسي
                        </li>
                    </ol>
                </nav>
            </div>

            <!-- الصورة -->
            <div class="col-lg-4 text-center">
                <img src="~/img/i4.jpg" alt="Study Materials"
                     class="img-fluid rounded"
                     style="max-height: 200px;">
            </div>
        </div>
    </div>
</section>

