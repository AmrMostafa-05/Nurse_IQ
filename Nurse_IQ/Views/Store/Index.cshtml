<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="js/language.js"></script>
<script src="js/app.js"></script>
<script>
    let cart = [];
    let wishlist = [];

    function filterProducts(category) {
        const products = document.querySelectorAll('[data-category]');
        products.forEach(product => {
            if (category === 'all' || product.dataset.category === category) {
                product.style.display = 'block';
            } else {
                product.style.display = 'none';
            }
        });
    }

    function addToCart(productId) {
        cart.push(productId);
        updateCartDisplay();
        showToast('تم إضافة المنتج إلى السلة', 'success');
    }

    function addToWishlist(productId) {
        wishlist.push(productId);
        showToast('تم إضافة المنتج إلى المفضلة', 'success');
    }

    function updateCartDisplay() {
        const cartItems = document.getElementById('cartItems');
        const cartTotal = document.getElementById('cartTotal');

        // Update cart items display
        cartItems.innerHTML = cart.map(item => `
            <div class="cart-item d-flex align-items-center mb-3 p-2 border rounded">
                <img src="img/i${item}.jpg" class="rounded me-3" style="width: 50px; height: 50px; object-fit: cover;">
                <div class="flex-grow-1">
                    <h6 class="mb-0">منتج ${item}</h6>
                    <small class="text-muted">100 جنيه</small>
                </div>
                <button class="btn btn-sm btn-outline-danger" onclick="removeFromCart(${item})">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        `).join('');

        // Update total
        cartTotal.textContent = (cart.length * 100) + ' جنيه';
    }

    function removeFromCart(productId) {
        const index = cart.indexOf(productId);
        if (index > -1) {
            cart.splice(index, 1);
            updateCartDisplay();
            showToast('تم حذف المنتج من السلة', 'info');
        }
    }

    function checkout() {
        if (cart.length === 0) {
            showToast('السلة فارغة', 'warning');
            return;
        }
        showToast('سيتم توجيهك لصفحة الدفع', 'success');
        // Redirect to checkout page
    }

    function toggleFilters() {
        // Toggle filter sidebar
        showToast('سيتم إضافة فلاتر متقدمة', 'info');
    }
</script>