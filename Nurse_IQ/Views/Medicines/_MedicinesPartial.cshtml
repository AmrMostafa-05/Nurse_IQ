@model IEnumerable<Nurse_IQ.Models.MedicineViewModel>
@if (Model != null && Model.Any())
{
    @foreach (var medicine in Model)
    {
        <div class="col-md-6 col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h6 class="card-title mb-0">@medicine.arabicName</h6>
                        <span class="badge bg-primary">@medicine.category</span>
                    </div>
                    <p class="text-muted small mb-2">@medicine.englishName</p>
                    <p class="card-text small">@medicine.description</p>
                    <div class="mb-2">
                        <small class="text-muted"><strong>الشكل:</strong> @medicine.form</small>
                    </div>
                    @if (!string.IsNullOrEmpty(medicine.indications))
                    {
                        <p class="text-muted small mb-2"><strong>الاستخدامات:</strong> @medicine.indications</p>
                    }
                    @if (!string.IsNullOrEmpty(medicine.dosage))
                    {
                        <p class="text-muted small mb-2"><strong>الجرعة:</strong> @medicine.dosage</p>
                    }
                    <div class="d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@medicine.Id" class="btn btn-primary btn-sm">
                            <i class="bi bi-eye me-2"></i>عرض التفاصيل
                        </a>
                        @if (User.IsInRole("Doctor") && User.Identity.Name == medicine.UserName)
                        {
                            <a asp-action="Edit" asp-route-id="@medicine.Id" class="btn btn-outline-warning btn-sm">
                                <i class="bi bi-pencil me-2"></i>تعديل
                            </a>
                            <a asp-action="Delete" asp-route-id="@medicine.Id" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-trash me-2"></i>حذف
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="empty-state text-center py-5">
        <i class="bi bi-search display-1 text-muted mb-3"></i>
        <h4 class="text-muted">لا توجد نتائج</h4>
        <p class="text-muted">جرب تغيير معايير البحث</p>
        <button class="btn btn-primary" onclick="resetFilters()">إعادة تعيين الفلاتر</button>
    </div>
}