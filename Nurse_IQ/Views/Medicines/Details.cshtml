@model Nurse_IQ.Models.MedicineViewModel
@{
    ViewData["Title"] = Model.arabicName;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="h2 fw-bold text-primary mb-4">@Model.arabicName</h2>
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <strong>اسم الدواء (إنجليزي):</strong> @Model.englishName
                </div>
                <div class="col-md-6 mb-3">
                    <strong>اسم الدواء (لاتيني):</strong> @Model.latinName
                </div>
                <div class="col-md-6 mb-3">
                    <strong>الفئة:</strong> @Model.category
                </div>
                <div class="col-md-6 mb-3">
                    <strong>الشكل الدوائي:</strong> @Model.form
                </div>
                <div class="col-12 mb-3">
                    <strong>الوصف:</strong> @Model.description
                </div>
                <div class="col-12 mb-3">
                    <strong>الاستخدامات:</strong> @Model.indications
                </div>
                @if (!string.IsNullOrEmpty(Model.sideEffects))
                {
                    <div class="col-12 mb-3">
                        <strong>الآثار الجانبية:</strong> @Model.sideEffects
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.dosage))
                {
                    <div class="col-12 mb-3">
                        <strong>الجرعة:</strong> @Model.dosage
                    </div>
                }
                <div class="col-12">
                    <strong>أضيف بواسطة:</strong> @Model.UserName
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <a asp-action="Index" class="btn btn-primary">العودة إلى القائمة</a>
                @if (User.IsInRole("Doctor") && User.Identity.Name == Model.UserName)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning">تعديل</a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">حذف</a>
                }
            </div>
        </div>
    </div>
</div>