@model Nurse_IQ.Models.Medicine
@{
    ViewData["Title"] = "حذف الدواء";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="h2 fw-bold text-primary mb-4">حذف الدواء</h2>
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <h5 class="text-danger">هل أنت متأكد من حذف هذا الدواء؟</h5>
            <div class="mb-3">
                <strong>اسم الدواء (عربي):</strong> @Model.arabicName
            </div>
            <div class="mb-3">
                <strong>اسم الدواء (إنجليزي):</strong> @Model.englishName
            </div>
            <div class="mb-3">
                <strong>الفئة:</strong> @Model.category
            </div>
            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">حذف</button>
                    <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>