@model Nurse_IQ.Controllers.TrainingViewModel
@{
    ViewData["Title"] = "المحتوى العملي";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Banner -->
<section class="page-banner">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="display-4 fw-bold mb-3">المحتوى العملي</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                        <li class="breadcrumb-item active">المحتوى العملي</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</section>

<!-- Tabs Navigation -->
<section class="py-4 bg-light">
    <div class="container">
        <ul class="nav nav-tabs justify-content-center" id="practicalTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="videos-tab" data-bs-toggle="tab" data-bs-target="#videos-tab-pane" type="button" role="tab" aria-controls="videos-tab-pane" aria-selected="true">
                    <i class="bi bi-play-btn me-2"></i>الفيديوهات التعليمية
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="jobs-tab" data-bs-toggle="tab" data-bs-target="#jobs-tab-pane" type="button" role="tab" aria-controls="jobs-tab-pane" aria-selected="false">
                    <i class="bi bi-briefcase me-2"></i>فرص العمل والتدريب
                </button>
            </li>
        </ul>
    </div>
</section>

<!-- Tab Content -->
<div class="tab-content" id="practicalTabsContent">
    <!-- Videos Tab -->
    <div class="tab-pane fade show active" id="videos-tab-pane" role="tabpanel" aria-labelledby="videos-tab" tabindex="0">
        <section class="py-5">
            <div class="container">
                <div class="row mb-5">
                    <div class="col-lg-8">
                        <h2 class="display-6 fw-bold text-primary mb-3">الفيديوهات العملية للتمريض</h2>
                        <p class="lead text-muted">شاهد وتعلم من فيديوهات تعليمية عملية تغطي مختلف مهارات التمريض</p>
                    </div>
                    <div class="col-lg-4 text-end">
                        <div class="d-flex gap-2 justify-content-end flex-wrap">
                            <button class="btn btn-outline-primary filter-btn active" data-filter="all">جميع الفيديوهات</button>
                            <button class="btn btn-outline-success filter-btn" data-filter="skills">المهارات الأساسية</button>
                            <button class="btn btn-outline-warning filter-btn" data-filter="emergency">الطوارئ</button>
                        </div>
                    </div>
                </div>

                <div class="row g-4" id="videosContainer">
                    @foreach (var video in Model.Videos)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card video-card h-100">
                                <div class="video-thumbnail position-relative">
                                    <img src="@video.thumbnailUrl" alt="@video.Title">
                                    <div class="play-btn" onclick="openVideoModal(@video.Id)">
                                        <i class="bi bi-play-fill"></i>
                                    </div>
                                    <span class="video-duration">@video.duration</span>
                                    <span class="video-category">@(video.category == "skills" ? "مهارات" : "طوارئ")</span>
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title">@video.Title</h5>
                                    <div class="d-flex align-items-center mb-3">
                                        <img src="@video.instructorImage" alt="@video.instructorName" class="rounded-circle me-2" width="30" height="30">
                                        <span class="text-muted small">@video.instructorName</span>
                                    </div>
                                    <p class="card-text text-muted small">@(video.Description.Length > 80 ? video.Description.Substring(0, 80) + "..." : video.Description)</p>
                                </div>
                                <div class="card-footer bg-transparent">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="video-stats">
                                            <span><i class="bi bi-eye"></i> @video.numberOfViews</span>
                                            <span><i class="bi bi-calendar"></i> video.publishedDate</span>
                                        </div>
                                        <a class="btn btn-sm btn-outline-primary" asp-action="VideoDetails" asp-route-id="@video.Id">
                                            <i class="bi bi-play-circle me-1"></i>شاهد الآن
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="text-center mt-5">
                    <button class="btn btn-primary btn-lg" onclick="loadMoreVideos()">
                        <i class="bi bi-arrow-down-circle me-2"></i>تحميل المزيد
                    </button>
                </div>
            </div>
        </section>
    </div>

    <!-- Jobs Tab -->
    <div class="tab-pane fade" id="jobs-tab-pane" role="tabpanel" aria-labelledby="jobs-tab" tabindex="0">
        <section class="py-5">
            <div class="container">
                <div class="row mb-5">
                    <div class="col-lg-8">
                        <h2 class="display-6 fw-bold text-primary mb-3">فرص العمل والتدريب</h2>
                        <p class="lead text-muted">اكتشف فرص العمل والتدريب العملي في أفضل المستشفيات والمراكز الطبية</p>
                    </div>
                    <div class="col-lg-4 text-end">
                        <div class="d-flex gap-2 justify-content-end">
                            <button class="btn btn-outline-primary filter-btn active" data-filter="all">جميع الفرص</button>
                            <button class="btn btn-outline-success filter-btn" data-filter="training">تدريب عملي</button>
                            <button class="btn btn-outline-warning filter-btn" data-filter="job">وظائف</button>
                        </div>
                    </div>
                </div>

                <div class="row g-4" id="jobListings">
                    @foreach (var job in Model.Trainings)
                    {
                        <div class="col-lg-6 col-xl-4">
                            <div class="card h-100">
                                <img src="@job.imageUrl" class="card-img-top" alt="@job.Title" style="height: 200px; object-fit: cover;">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <span class="badge @(job.Category == "job" ? "bg-success" : "bg-warning")">@(job.Category == "job" ? "وظيفة" : "تدريب عملي")</span>
                                        <span class="badge bg-primary">@job.Category</span>
                                    </div>
                                    <h5 class="card-title">@job.Title</h5>
                                    <p class="text-muted mb-2">
                                        <i class="bi bi-building me-1"></i>@job.HospitalName
                                    </p>
                                    <p class="text-muted mb-2">
                                        <i class="bi bi-geo-alt me-1"></i>@job.Location
                                    </p>
                                    <p class="text-muted mb-2">
                                        <i class="bi bi-cash me-1"></i>الراتب: @job.salary جنيه
                                    </p>
                                    @if (!string.IsNullOrEmpty(job.Experience))
                                    {
                                        <p class="text-muted mb-2">
                                            <i class="bi bi-briefcase me-1"></i>الخبرة: @job.Experience
                                        </p>
                                    }
                                    <p class="card-text">@job.Description</p>
                                    <div class="mb-3">
                                        <small class="text-muted">
                                            <i class="bi bi-clock me-1"></i>آخر موعد للتقديم: @job.deadline.ToString("yyyy-MM-dd")
                                        </small>
                                    </div>
                                </div>
                                <div class="card-footer">
                                    <div class="d-flex gap-2">
                                        <a class="btn btn-primary flex-fill" asp-action="JobDetails" asp-route-id="@job.Id">
                                            <i class="bi bi-eye me-2"></i>عرض التفاصيل
                                        </a>
                                        <a class="btn btn-success" asp-action="Apply" asp-route-id="@job.Id">
                                            <i class="bi bi-send"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    </div>
</div>

<!-- Video Modal -->
<div class="modal fade video-modal" id="videoModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="videoModalTitle">عنوان الفيديو</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div class="video-player" id="videoPlayer"></div>
                <div class="p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="video-stats">
                            <span><i class="bi bi-eye"></i> <span id="videoViews"></span> مشاهدة</span>
                            <span><i class="bi bi-calendar"></i> <span id="videoDate"></span></span>
                            <span><i class="bi bi-clock"></i> <span id="videoDuration"></span></span>
                        </div>
                        <div>
                            <button class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-download me-1"></i>تحميل
                            </button>
                        </div>
                    </div>
                    <h6>وصف الفيديو:</h6>
                    <p id="videoDescription" class="text-muted"></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentVideoFilter = 'all';
        let displayedVideos = 6;

        function displayVideos(filter = currentVideoFilter) {
            currentVideoFilter = filter;
            const videosContainer = document.getElementById('videosContainer');
            const filterButtons = document.querySelectorAll('.filter-btn');
            filterButtons.forEach(btn => btn.classList.remove('active'));
            document.querySelector(`.filter-btn[data-filter="${filter}"]`).classList.add('active');
        }

        function openVideoModal(videoId) {
            fetch(`/Training/VideoDetails/${videoId}`)
                .then(response => response.text())
                .then(html => {
                    const modal = new bootstrap.Modal(document.getElementById('videoModal'));
                    document.getElementById('videoPlayer').innerHTML = html;
                    document.getElementById('videoModalTitle').textContent = document.querySelector('#videoPlayer').dataset.title;
                    document.getElementById('videoDescription').textContent = document.querySelector('#videoPlayer').dataset.description;
                    document.getElementById('videoViews').textContent = document.querySelector('#videoPlayer').dataset.views;
                    document.getElementById('videoDate').textContent = document.querySelector('#videoPlayer').dataset.date;
                    document.getElementById('videoDuration').textContent = document.querySelector('#videoPlayer').dataset.duration;
                    modal.show();
                });
        }

        function loadMoreVideos() {
            displayedVideos += 3;
            displayVideos();
        }

        function formatDate(dateString) {
            const date = new Date(dateString);
            const now = new Date();
            const diffTime = Math.abs(now - date);
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            if (diffDays === 1) return "أمس";
            if (diffDays < 7) return `منذ ${diffDays} أيام`;
            if (diffDays < 30) return `منذ ${Math.floor(diffDays/7)} أسابيع`;
            return `منذ ${Math.floor(diffDays/30)} أشهر`;
        }

        function showToast(message, type = 'info') {
            const toastContainer = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast show bg-${type} text-white`;
            toast.innerHTML = `<div class="toast-body">${message}</div>`;
            toastContainer.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        }

        document.addEventListener('DOMContentLoaded', function() {
            displayVideos();
        });

            //Video filter
        document.querySelectorAll('#videos-tab-pane .filter-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                const category = this.dataset.filter;
                document.querySelectorAll('#videos-tab-pane .filter-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');

                fetch(`/Training/GetVideosByCategory?category=${category}`)
                    .then(res => res.text())
                    .then(html => {
                        document.getElementById('videosContainer').innerHTML = html;
                    });
            });
        });

        // jop filter 
        document.querySelectorAll('#jobs-tab-pane .filter-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                const category = this.dataset.filter;
                document.querySelectorAll('#jobs-tab-pane .filter-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');

                fetch(`/Training/GetTrainingsByCategory?category=${category}`)
                    .then(res => res.text())
                    .then(html => {
                        document.getElementById('jobListings').innerHTML = html;
                    });
            });
        });
    </script>
}