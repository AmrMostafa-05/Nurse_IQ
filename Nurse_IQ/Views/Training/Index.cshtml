@model TrainingViewModel
@{
    ViewData["Title"] = "المحتوى العملي";
}



<!-- Page Banner -->
<section class="page-banner">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="display-4 fw-bold mb-3">المحتوى العملي</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                        <li class="breadcrumb-item active">المحتوى العملي</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</section>

<!-- Tabs Navigation -->
<section class="py-4 bg-light">
    <div class="container">
        <ul class="nav nav-tabs justify-content-center" id="practicalTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="videos-tab" data-bs-toggle="tab" data-bs-target="#videos-tab-pane" type="button" role="tab" aria-controls="videos-tab-pane" aria-selected="true">
                    <i class="bi bi-play-btn me-2"></i>الفيديوهات التعليمية
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="jobs-tab" data-bs-toggle="tab" data-bs-target="#jobs-tab-pane" type="button" role="tab" aria-controls="jobs-tab-pane" aria-selected="false">
                    <i class="bi bi-briefcase me-2"></i>فرص العمل والتدريب
                </button>
            </li>
        </ul>
    </div>
</section>

<!-- Tab Content -->
<div class="tab-content" id="practicalTabsContent">
    <!-- Videos Tab `-->
    <div class="tab-pane fade show active" id="videos-tab-pane" role="tabpanel" aria-labelledby="videos-tab" tabindex="0">
        <section class="py-5">
            <div class="container">
                <div class="row mb-5">
                    <div class="col-lg-8">
                        <h2 class="display-6 fw-bold text-primary mb-3">الفيديوهات العملية للتمريض</h2>
                        <p class="lead text-muted">شاهد وتعلم من فيديوهات تعليمية عملية تغطي مختلف مهارات التمريض</p>
                    </div>
                    <div class="col-lg-4 text-end">
                        <div class="d-flex gap-2 justify-content-end flex-wrap">
                            <button class="btn btn-outline-primary filter-btn active" onclick="filterVideos('all')">جميع الفيديوهات</button>
                            <button class="btn btn-outline-success filter-btn" onclick="filterVideos('skills')">المهارات الأساسية</button>
                            <button class="btn btn-outline-warning filter-btn" onclick="filterVideos('emergency')">الطوارئ</button>
                        </div>
                    </div>
                </div>
                
                <div class="row g-4" id="videosContainer">
                    @if (Model.TrainingVideos.Any())
                    {
                        @foreach (var video in Model.TrainingVideos)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="card video-card h-100">
                                    <div class="video-thumbnail position-relative">
                                        <img src="@video.thumbnailUrl" alt="@video.Title">
                                        <div class="play-btn" onclick="openVideoModal(@video.Id)">
                                            <i class="bi bi-play-fill"></i>
                                        </div>
                                        <span class="video-duration">@video.duration</span>
                                        <span class="video-category">@video.category</span>
                                    </div>
                                    <div class="card-body">
                                        <h5 class="card-title">@video.Title</h5>
                                        <div class="d-flex align-items-center mb-3">
                                            <img src="~/img/instructor1.jpg" alt="@video.instructorName" class="rounded-circle me-2" width="30" height="30">
                                            <span class="text-muted small">@video.instructorName</span>
                                        </div>
                                        <p class="card-text text-muted small">@(video.Description.Length > 80 ? video.Description.Substring(0, 80) + "..." : video.Description)</p>
                                    </div>
                                    <div class="card-footer bg-transparent">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="video-stats">
                                                <span><i class="bi bi-eye"></i> @video.</span>
                                                <span><i class="bi bi-calendar"></i> @video.publishedDate.ToString()</span>
                                            </div>
                                            <button class="btn btn-sm btn-outline-primary" onclick="openVideoModal(@video.Id)">
                                                <i class="bi bi-play-circle me-1"></i>شاهد الآن
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12 text-center py-5">
                            <i class="bi bi-camera-video-off display-1 text-muted"></i>
                            <h4 class="mt-3 text-muted">لا توجد فيديوهات</h4>
                            <p class="text-muted">جرب تغيير الفلتر أو عد لاحقاً</p>
                        </div>
                    }
                </div>
            </div>
        </section>
    </div>

    <!-- Jobs Tab -->
    <div class="tab-pane fade" id="jobs-tab-pane" role="tabpanel" aria-labelledby="jobs-tab" tabindex="0">
        <section class="py-5">
            <div class="container">
                <div class="row mb-5">
                    <div class="col-lg-8">
                        <h2 class="display-6 fw-bold text-primary mb-3">فرص العمل والتدريب</h2>
                        <p class="lead text-muted">اكتشف فرص العمل والتدريب العملي في أفضل المستشفيات والمراكز الطبية</p>
                    </div>
                    <div class="col-lg-4 text-end">
                        <div class="d-flex gap-2 justify-content-end">
                            <button class="btn btn-outline-primary" onclick="filterJobs('all')">جميع الفرص</button>
                            <button class="btn btn-outline-success" onclick="filterJobs('training')">تدريب عملي</button>
                            <button class="btn btn-outline-warning" onclick="filterJobs('job')">وظائف</button>
                        </div>
                    </div>
                </div>

                <div class="row g-4" id="jobListings">
                    @if (Model.Trainings.Any())
                    {
                        @foreach (var training in Model.Trainings)
                        {
                            <div class="col-lg-6 col-xl-4">
                                <div class="card h-100">
                                    <img src="~/img/training.jpg" class="card-img-top" alt="@training.Title" style="height: 200px; object-fit: cover;">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <span class="badge bg-warning">تدريب عملي</span>
                                            <span class="badge bg-primary">@training.Category</span>
                                        </div>
                                        <h5 class="card-title">@training.Title</h5>
                                        <p class="text-muted mb-2">
                                            <i class="bi bi-building me-1"></i>@training.HospitalName
                                        </p>
                                        <p class="text-muted mb-2">
                                            <i class="bi bi-geo-alt me-1"></i>@training.Location
                                        </p>
                                        <p class="text-muted mb-2">
                                            <i class="bi bi-calendar me-1"></i>المدة: @training.postedDate
                                        </p>
                                        <p class="text-muted mb-2">
                                            <i class="bi bi-cash me-1"></i>البدل: @training.salary
                                        </p>
                                        <p class="card-text">@training.Description</p>
                                        <div class="mb-3">
                                            <small class="text-muted">
                                                <i class="bi bi-clock me-1"></i>آخر موعد للتقديم: @training.deadline.ToString("yyyy-MM-dd")
                                            </small>
                                        </div>
                                    </div>
                                    <div class="card-footer">
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-primary flex-fill" onclick="viewJobDetails(@training.Id)">
                                                <i class="bi bi-eye me-2"></i>عرض التفاصيل
                                            </button>
                                            <button class="btn btn-success" onclick="applyForJob(@training.Id)">
                                                <i class="bi bi-send"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12 text-center py-5">
                            <i class="bi bi-search display-1 text-muted"></i>
                            <h4 class="mt-3 text-muted">لا توجد فرص متاحة</h4>
                            <p class="text-muted">جرب تغيير الفلتر أو عد لاحقاً</p>
                        </div>
                    }
                </div>
            </div>
        </section>
    </div>
</div>

<!-- Video Modal -->
<div class="modal fade video-modal" id="videoModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="videoModalTitle">عنوان الفيديو</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div class="video-player" id="videoPlayer">
                    <!-- Video will be loaded here -->
                </div>
                <div class="p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="video-stats">
                            <span><i class="bi bi-eye"></i> <span id="videoViews">0</span> مشاهدة</span>
                            <span><i class="bi bi-calendar"></i> <span id="videoDate">0</span></span>
                            <span><i class="bi bi-clock"></i> <span id="videoDuration">0</span></span>
                        </div>
                        <div>
                            <button class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-download me-1"></i>تحميل
                            </button>
                        </div>
                    </div>
                    <h6>وصف الفيديو:</h6>
                    <p id="videoDescription" class="text-muted"></p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Application Modal -->
<div class="modal fade" id="applicationModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="applicationModalTitle">تقديم طلب</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="applicationModalBody">
                <!-- Application form will be populated here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
                <button type="button" class="btn btn-primary" onclick="submitApplication()">إرسال الطلب</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Video data from server
        const videoData = @Html.Raw(Json.Serialize(Model.TrainingVideos));
        const trainingData = @Html.Raw(Json.Serialize(Model.Trainings));

        // Video functions
        let currentVideoFilter = 'all';

        function filterVideos(filter) {
            currentVideoFilter = filter;
            
            // Update active button state
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            event.target.classList.add('active');
            
            // Filter videos based on category
            const videosContainer = document.getElementById('videosContainer');
            const videoCards = videosContainer.querySelectorAll('.col-md-6');
            
            videoCards.forEach(card => {
                const categorySpan = card.querySelector('.video-category');
                const category = categorySpan ? categorySpan.textContent.trim() : '';
                
                if (filter === 'all' || 
                    (filter === 'skills' && category.includes('مهارات')) ||
                    (filter === 'emergency' && category.includes('طوارئ'))) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        function openVideoModal(videoId) {
            const video = videoData.find(v => v.id === videoId);
            if (!video) return;

            const modal = new bootstrap.Modal(document.getElementById('videoModal'));
            document.getElementById('videoModalTitle').textContent = video.title;
            document.getElementById('videoDescription').textContent = video.description;
            document.getElementById('videoDate').textContent = formatDate(video.uploadDate);
            document.getElementById('videoDuration').textContent = video.duration;
            document.getElementById('videoViews').textContent = video.views;
            
            // Load video in iframe
            document.getElementById('videoPlayer').innerHTML = `
                <iframe width="100%" height="400" src="${video.videoUrl}" 
                    frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                    allowfullscreen></iframe>
            `;
            
            modal.show();
        }

        // Job functions
        let currentJobFilter = 'all';

        function filterJobs(filter) {
            currentJobFilter = filter;
            
            // Filter jobs based on type
            const jobListings = document.getElementById('jobListings');
            const jobCards = jobListings.querySelectorAll('.col-lg-6');
            
            jobCards.forEach(card => {
                const badge = card.querySelector('.badge');
                const type = badge ? badge.textContent.trim() : '';
                
                if (filter === 'all' || 
                    (filter === 'training' && type.includes('تدريب')) ||
                    (filter === 'job' && type.includes('وظيفة'))) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        function viewJobDetails(trainingId) {
            const training = trainingData.find(t => t.id === trainingId);
            if (!training) return;

            const modal = new bootstrap.Modal(document.getElementById('applicationModal'));
            document.getElementById('applicationModalTitle').textContent = training.title;
            
            document.getElementById('applicationModalBody').innerHTML = `
                <div class="row">
                    <div class="col-md-4">
                        <img src="/img/training.jpg" class="img-fluid rounded" alt="${training.title}">
                    </div>
                    <div class="col-md-8">
                        <h6 class="text-muted">${training.hospitalName} - ${training.location}</h6>
                        <p class="mb-3">${training.description}</p>
                        
                        <div class="row mb-3">
                            <div class="col-6">
                                <strong>المدة:</strong> ${training.duration}
                            </div>
                            <div class="col-6">
                                <strong>البدل:</strong> ${training.salary}
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <strong>المتطلبات:</strong>
                            <ul class="mt-2">
                                <li>طالب في السنة الثالثة أو الرابعة</li>
                                <li>معدل تراكمي لا يقل عن 3.0</li>
                                <li>التزام كامل بالتدريب</li>
                            </ul>
                        </div>
                        
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            آخر موعد للتقديم: ${formatDate(training.applicationDeadline)}
                        </div>
                    </div>
                </div>
            `;
            
            modal.show();
        }

        function applyForJob(trainingId) {
            const training = trainingData.find(t => t.id === trainingId);
            if (!training) return;

            const modal = new bootstrap.Modal(document.getElementById('applicationModal'));
            document.getElementById('applicationModalTitle').textContent = `تقديم طلب - ${training.title}`;
            
            document.getElementById('applicationModalBody').innerHTML = `
                <form id="applicationForm">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="applicantName" class="form-label">الاسم الكامل *</label>
                            <input type="text" class="form-control" id="applicantName" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="applicantEmail" class="form-label">البريد الإلكتروني *</label>
                            <input type="email" class="form-control" id="applicantEmail" required>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="applicantPhone" class="form-label">رقم الهاتف *</label>
                            <input type="tel" class="form-control" id="applicantPhone" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="applicantUniversity" class="form-label">الجامعة/المعهد *</label>
                            <input type="text" class="form-control" id="applicantUniversity" required>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="applicantYear" class="form-label">الفرقة الدراسية *</label>
                            <select class="form-select" id="applicantYear" required>
                                <option value="">اختر الفرقة</option>
                                <option value="first">فرقة أولى</option>
                                <option value="second">فرقة ثانية</option>
                                <option value="third">فرقة ثالثة</option>
                                <option value="fourth">فرقة رابعة</option>
                                <option value="internship">امتياز</option>
                                <option value="graduate">خريج</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="applicantGPA" class="form-label">المعدل التراكمي *</label>
                            <input type="number" class="form-control" id="applicantGPA" step="0.01" min="0" max="4" required>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="applicantExperience" class="form-label">الخبرات السابقة</label>
                        <textarea class="form-control" id="applicantExperience" rows="3" placeholder="اذكر خبراتك السابقة في مجال التمريض..."></textarea>
                    </div>
                    
                    <div class="mb-3">
                        <label for="applicantMotivation" class="form-label">سبب التقديم *</label>
                        <textarea class="form-control" id="applicantMotivation" rows="3" required placeholder="اشرح لماذا تريد هذه الفرصة..."></textarea>
                    </div>
                    
                    <div class="mb-3">
                        <label for="applicantCV" class="form-label">السيرة الذاتية (PDF) *</label>
                        <input type="file" class="form-control" id="applicantCV" accept=".pdf" required>
                    </div>
                </form>
            `;
            
            modal.show();
        }

        function submitApplication() {
            // Basic validation
            const form = document.getElementById('applicationForm');
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            showToast('جاري إرسال طلبك...', 'info');
            
            // Get form data
            const formData = {
                applicantName: document.getElementById('applicantName').value,
                applicantEmail: document.getElementById('applicantEmail').value,
                applicantPhone: document.getElementById('applicantPhone').value,
                applicantUniversity: document.getElementById('applicantUniversity').value,
                applicantYear: document.getElementById('applicantYear').value,
                applicantGPA: document.getElementById('applicantGPA').value,
                applicantExperience: document.getElementById('applicantExperience').value,
                applicantMotivation: document.getElementById('applicantMotivation').value
            };

            // Send to server
            fetch('/Training/ApplyForTraining', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify(formData)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showToast(data.message, 'success');
                    const modal = bootstrap.Modal.getInstance(document.getElementById('applicationModal'));
                    modal.hide();
                } else {
                    showToast(data.message, 'error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showToast('حدث خطأ أثناء إرسال الطلب', 'error');
            });
        }

        function formatDate(dateString) {
            const date = new Date(dateString);
            const now = new Date();
            const diffTime = Math.abs(now - date);
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)); 
            
            if (diffDays === 1) return "أمس";
            if (diffDays < 7) return `منذ ${diffDays} أيام`;
            if (diffDays < 30) return `منذ ${Math.floor(diffDays/7)} أسابيع`;
            return `منذ ${Math.floor(diffDays/30)} أشهر`;
        }

        function showToast(message, type = 'info') {
            const toastContainer = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast show bg-${type} text-white`;
            toast.innerHTML = `
                <div class="toast-body">
                    ${message}
                </div>
            `;
            toastContainer.appendChild(toast);
            
            setTimeout(() => {
                toast.remove();
            }, 3000);
        }

        // Initialize page
        document.addEventListener('DOMContentLoaded', function() {
            // Page is already initialized with server data
        });
    </script>
}
