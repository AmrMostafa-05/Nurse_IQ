@model Nurse_IQ.Models.training_video
@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Banner -->
<section class="page-banner">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="display-4 fw-bold mb-3">المحتوى العملي</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                        <li class="breadcrumb-item active">المحتوى العملي</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</section>

<section>
<div class="container">
    <div class="video-player" id="videoPlayer"
         data-title="@Model.Title"
         data-description="@Model.Description"
         data-views="@Model.numberOfViews"
         data-date="@FormatDate(Model.publishedDate)"
         data-duration="@Model.duration">
        <iframe width="100%" height="400" src="@Model.videoUrl"
                frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen></iframe>
    </div>
    <div class="p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="video-stats">
                <span><i class="bi bi-eye"></i> @Model.numberOfViews مشاهدة</span>
                <span><i class="bi bi-calendar"></i> @FormatDate(Model.publishedDate)</span>
                <span><i class="bi bi-clock"></i> @Model.duration</span>
            </div>
            <div>
                <button class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-download me-1"></i>تحميل
                </button>
            </div>
        </div>
        <h6>وصف الفيديو:</h6>
        <p class="text-muted">@Model.Description</p>
    </div>
</div>
</section>
@functions {
    string FormatDate(string dateString)
    {
        if (DateTime.TryParse(dateString, out var date))
        {
            var now = DateTime.Now;
            var diff = now - date;
            var diffDays = (int)diff.TotalDays;
            if (diffDays == 1) return "أمس";
            if (diffDays < 7) return $"منذ {diffDays} أيام";
            if (diffDays < 30) return $"منذ {diffDays / 7} أسابيع";
            return $"منذ {diffDays / 30} أشهر";
        }
        return dateString;
    }
}