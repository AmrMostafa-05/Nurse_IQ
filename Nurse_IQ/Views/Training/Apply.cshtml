@model Nurse_IQ.Controllers.ApplicationViewModel
@{
    ViewData["Title"] = $"تقديم طلب - {Model.TrainingTitle}";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- Page Banner -->
<section class="page-banner">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="display-4 fw-bold mb-3">المحتوى العملي</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                        <li class="breadcrumb-item active">المحتوى العملي</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</section>

<div class="container">
    <h2 class="mb-4">تقديم طلب: @Model.TrainingTitle</h2>
    <form id="applicationForm" asp-action="Apply" method="post">
        <input type="hidden" asp-for="TrainingId" />
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="ApplicantName" class="form-label">الاسم الكامل *</label>
                <input asp-for="ApplicantName" class="form-control" required>
                <span asp-validation-for="ApplicantName" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="ApplicantEmail" class="form-label">البريد الإلكتروني *</label>
                <input asp-for="ApplicantEmail" class="form-control" type="email" required>
                <span asp-validation-for="ApplicantEmail" class="text-danger"></span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="ApplicantPhone" class="form-label">رقم الهاتف *</label>
                <input asp-for="ApplicantPhone" class="form-control" required>
                <span asp-validation-for="ApplicantPhone" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="ApplicantUniversity" class="form-label">الجامعة/المعهد *</label>
                <input asp-for="ApplicantUniversity" class="form-control" required>
                <span asp-validation-for="ApplicantUniversity" class="text-danger"></span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="ApplicantYear" class="form-label">الفرقة الدراسية *</label>
                <select asp-for="ApplicantYear" class="form-select" required>
                    <option value="">اختر الفرقة</option>
                    <option value="first">فرقة أولى</option>
                    <option value="second">فرقة ثانية</option>
                    <option value="third">فرقة ثالثة</option>
                    <option value="fourth">فرقة رابعة</option>
                    <option value="internship">امتياز</option>
                    <option value="graduate">خريج</option>
                </select>
                <span asp-validation-for="ApplicantYear" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="ApplicantGPA" class="form-label">المعدل التراكمي *</label>
                <input asp-for="ApplicantGPA" class="form-control" type="number" step="0.01" min="0" max="4" required>
                <span asp-validation-for="ApplicantGPA" class="text-danger"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="ApplicantExperience" class="form-label">الخبرات السابقة</label>
            <textarea asp-for="ApplicantExperience" class="form-control" rows="3" placeholder="اذكر خبراتك السابقة في مجال التمريض..."></textarea>
        </div>
        <div class="mb-3">
            <label asp-for="ApplicantMotivation" class="form-label">سبب التقديم *</label>
            <textarea asp-for="ApplicantMotivation" class="form-control" rows="3" required placeholder="اشرح لماذا تريد هذه الفرصة..."></textarea>
            <span asp-validation-for="ApplicantMotivation" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label for="applicantCV" class="form-label">السيرة الذاتية (PDF) *</label>
            <input type="file" class="form-control" id="applicantCV" name="applicantCV" accept=".pdf" required>
        </div>
        <div class="text-end">
            <button type="submit" class="btn btn-primary">إرسال الطلب</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('applicationForm').addEventListener('submit', function(event) {
            if (!this.checkValidity()) {
                event.preventDefault();
                this.reportValidity();
            }
        });
    </script>
}